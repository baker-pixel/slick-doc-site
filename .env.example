# ── App (required in production) ────────────────────────────────────────────
# Public URL of this app — used to generate the WordPress plugin ZIP download link
VITE_APP_URL="https://your-app-domain.com"

# ── Supabase (required) ─────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<supabase-anon-key>"

# NOTE: Never add SUPABASE_SERVICE_ROLE_KEY here — it must only exist in
# Supabase edge function secrets (set via `supabase secrets set`).

# ── Edge function secrets (server-side only, set via Supabase CLI) ───────────
# supabase secrets set GROQ_API_KEY=<your-key>
# supabase secrets set ADMIN_PASSWORD=<your-password>
# supabase secrets set RESEND_API_KEY=<your-key>
# supabase secrets set N8N_WEBHOOK_URL=<your-url>
# supabase secrets set ANTHROPIC_API_KEY=<your-key>   ← required for WP SEO scan AI fixes
# supabase secrets set APP_URL=<your-app-domain>      ← used to call /api/render-report-pdf and /api/render-brand-assets
# supabase secrets set BRAND_RENDER_SECRET=<random-value>  ← shared secret for extract-brand-assets -> /api/render-brand-assets

# ── Vercel Function env vars (set via `vercel env add`, not this file) ───────
# BRAND_RENDER_SECRET must match the Supabase secret above exactly — it's how
# /api/render-brand-assets authenticates the Supabase edge function as its
# caller, since it navigates arbitrary client-supplied URLs and can't be left
# open to the public internet.
